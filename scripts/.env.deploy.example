# =============================================================================
# 無名の主页 · Docker 部署环境变量示例
# =============================================================================
# 用法：
#   1. 复制本文件为 .env.deploy
#   2. 修改下方变量
#   3. docker compose --env-file .env.deploy up -d --build
# =============================================================================

# 对外端口（容器内固定为 12446）
PORT=12446

# admin-server 鉴权 token（生产环境强烈建议设置）
# 设置后所有 /api/* 请求需带 X-Admin-Token 头
ADMIN_TOKEN=change-me-to-a-strong-secret
